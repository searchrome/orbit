# Optional OpenRouter configuration. Copy to .env and supply your own key.
# Basic browsing does not require a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Orbit

# Optional: hide the OpenCode terminal.
# OPENCODE_TERMINAL_ENABLED=false
