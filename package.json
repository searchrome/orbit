{
  "name": "browser",
  "version": "1.0.0",
  "description": "Orbit: an Electron browser with AI assistants, tab groups, saved sessions, and media casting",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/ensure-node-pty-helper.js",
    "agent:harness": "node scripts/browser-agent-harness.js",
    "test": "jest",
    "test:e2e": "jest --testMatch='**/__tests__/e2e/**/*.test.js'",
    "test:unit": "jest --testMatch='**/__tests__/unit/**/*.test.js'",
    "test:integration": "jest --testMatch='**/__tests__/integration/**/*.test.js'",
    "test:mocha": "electron-mocha",
    "measure:selector-output": "node scripts/measure-selector-output.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "package": "electron-packager . browser --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:mac": "node scripts/build-macos.js"
  },
  "keywords": [
    "electron",
    "browser"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@testing-library/jest-dom": "^6.6.3",
    "chai": "^5.2.0",
    "electron": "^35.1.4",
    "electron-mocha": "^13.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-tiktoken": "^1.0.21",
    "spectron": "^19.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "jsdom": "^26.0.0",
    "node-pty": "^1.1.0",
    "youtube-transcript": "^1.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/searchrome/orbit.git"
  },
  "homepage": "https://github.com/searchrome/orbit#readme",
  "bugs": {
    "url": "https://github.com/searchrome/orbit/issues"
  }
}
